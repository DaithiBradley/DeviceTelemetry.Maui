<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>
      net9.0-windows10.0.19041.0;
    </TargetFrameworks>

    <UseMaui>true</UseMaui>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet -->
    <PackageId>DeviceTelemetry.Maui</PackageId>
    <Version>1.0.0</Version>
    <Authors>YourCompany</Authors>
    <Description>Cross-platform device telemetry utilities for .NET MAUI</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.111" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DeviceTelemetry.Maui.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DeviceTelemetry.Maui.Tests/**" />
    <EmbeddedResource Remove="DeviceTelemetry.Maui.Tests/**" />
    <None Remove="DeviceTelemetry.Maui.Tests/**" />
  </ItemGroup>

</Project>
